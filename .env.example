# Copy this file to ".env" and adjust as needed. ".env" is git-ignored,
# so real secrets never get committed.

# Port the Express server listens on
PORT=3000

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call the API with credentials.
# Only needed if you serve the frontend from a different origin/port than
# the API (e.g. VS Code "Live Server" on 5500 while the API runs on 3000).
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Supabase ---
# Find these in your Supabase project: Project Settings -> API.
# SUPABASE_URL looks like https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" secret key here, NOT the "anon" public key.
# This key must never be exposed to the browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "production" when deployed (e.g. on Render) so session cookies use
# the "secure" flag correctly. Leave unset for local development.
NODE_ENV=development
